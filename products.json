{
  "$comment": "Every Hawkes product Studio builds, playtests and reports on. Paths are relative to C:\\Projects. local.serve: how Studio starts the product locally for playtests (npm: the dev server; static: python's http.server over a folder). playtests: what runs each day (where: local or live). Scenarios come from each game's playtest contract (docs/playtest.md). dev: developing on beta (src/dev.ts): front = the /dev/ front door port Caddy routes https://<sub>.hawkesgen.com/dev/* to, port = the dev server port in the beta working copy (web products), path = the devtools page.",
  "products": [
    {
      "id": "doseofdestruction",
      "name": "Dose Of Destruction",
      "framing": "cytotoxic dose",
      "engine": "web",
      "repo": "doseofdestructionwebsite",
      "site": "doseofdestructionwebsite",
      "live": "https://doseofdestruction.com/Game/",
      "local": {
        "serve": "npm",
        "dir": "doseofdestructionwebsite",
        "port": 8089,
        "path": "/Game/"
      },
      "checks": [
        {
          "dir": "doseofdestructionwebsite",
          "cmd": "npm test"
        },
        {
          "dir": "doseofdestructionwebsite",
          "cmd": "npm run typecheck"
        }
      ],
      "playtests": [
        {
          "scenario": "smoke",
          "where": "local"
        },
        {
          "scenario": "match",
          "where": "local"
        },
        {
          "scenario": "campaign",
          "where": "local"
        },
        {
          "scenario": "smoke",
          "where": "live"
        },
        {
          "scenario": "smoke",
          "where": "live",
          "device": "phone"
        }
      ],
      "story": [
        "doseofdestructionwebsite/content/campaign.json"
      ],
      "about": "A browser platform fighter (Babylon.js) with every main Hawkes IP character. The campaign is a TV show, from Open Mic (a walk-on with one skateboard, Exit Punk) to Encore. Fighters, poses and animations are AI-generated.",
      "contract": true,
      "dev": {
        "front": 8701,
        "port": 8711,
        "path": "/devtools.html",
        "env": {
          "DOD_ART_ROOT": "${PROJECTS}/AllTheCharacters",
          "DOD_MAPS_ROOT": "${PROJECTS}/AllTheMaps"
        }
      }
    },
    {
      "id": "phorigins",
