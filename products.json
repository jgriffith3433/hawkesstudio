        {
          "scenario": "smoke",
          "where": "live",
          "device": "phone"
        }
      ],
      "story": [
        "phoriginsassets/Lore.txt"
      ],
      "about": "A third-person story game (Babylon.js): one night in Hawkes Tower. The board meets, B3 writes back, Pierce Hawkes goes down to the vat and transforms. Levels 1-6 are playable; dialogue, voice lines and cutscenes.",
      "deploy": {
        "prebuild": "npm run build"
      },
      "contract": true,
      "dev": {
        "front": 8702,
        "port": 8712,
        "path": "/devtools.html"
      }
    },
