{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DnsForTheDomain",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange",
        "route53domains:ListDomains",
        "route53domains:GetDomainDetail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CertificatesAndLoadBalancer",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:AddTagsToCertificate",
        "acm:DeleteCertificate",
        "elasticloadbalancing:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LibraryStorageInHawkesBucketsOnly",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::hawkes-*", "arn:aws:s3:::hawkes-*/*"]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "SecretsUnderHawkesOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:*:028793236279:secret:hawkes/*"
    },
    {
      "Sid": "ListSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecrets",
      "Resource": "*"
    },
    {
      "Sid": "ServerRolesUnderHawkesPathOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::028793236279:role/hawkes/*",
        "arn:aws:iam::028793236279:instance-profile/hawkes/*"
      ]
    },
    {
      "Sid": "ServerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:PutRetentionPolicy", "logs:DescribeLogGroups"],
      "Resource": "*"
    }
  ]
}
