<Project Sdk="Microsoft.NET.Sdk">
  <!-- Studio's Unity check, the exact C# front end (src/unitycheck.ts runs it when /opt/unity-check/unity-check exists).
       Published self-contained for linux-x64 in the agent image (server/studio-cloudrun/Dockerfile). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>unity-check</AssemblyName>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>
</Project>
