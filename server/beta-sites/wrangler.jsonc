// The beta sites: one Worker for every product's beta site, both Studio lanes (docs/studio-cloudrun.md, "Beta sites").
// J, once: node tools/beta-sites/setup.mjs --apply (makes the R2 bucket, then deploys this from here). By hand:
//   npx wrangler r2 bucket create hawkes-beta-sites && npx wrangler deploy
// Each custom domain below makes its DNS record; a host that already has a record must lose it first (Cloudflare says so).
// Not here on purpose: hawkesnet (its own box) and hawkesgenwebsite (Firebase): products.json "previews" lists them too.
{
  "name": "hawkes-beta-sites",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "hawkes-beta-sites" }],
  "vars": {
    "DOMAIN": "hawkesgen.ai",
    // The Cloud Run addresses (the keys and the 🐞 posts go straight there) and where people sign in.
    "STUDIO_ORIGIN_LIVE": "https://studio-388576319982.us-east4.run.app",
    "STUDIO_ORIGIN_BETA": "https://studio-beta-388576319982.us-central1.run.app",
    "STUDIO_PUBLIC_LIVE": "https://studio.hawkesgen.ai",
    "STUDIO_PUBLIC_BETA": "https://studio-beta.hawkesgen.ai",
    "CELLS_PROJECT_NUMBER": "388576319982",
    "CELLS_REGION_LIVE": "us-east4",
    "CELLS_REGION_BETA": "us-central1"
  },
  "routes": [
    // Where Studio publishes (signed writes only; nothing to see there).
    { "pattern": "sites.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    // Live Studio's beta sites: products.json "previews".
    { "pattern": "dod.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "phorigins.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sickofit.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "yoobaland.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "placedept.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "icanbe.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "imaginelivetv.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "corporate.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    // studio-beta's copies of them.
    { "pattern": "sb-dod.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-phorigins.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-sickofit.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-yoobaland.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-placedept.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-icanbe.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-imaginelivetv.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "sb-corporate.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }
  ],
  // Workers Logs (2026-11-02: the account reached 75% of its Workers Logs allowance): no log line per request
  // (invocation_logs off; Cloudflare's own request metrics stay), traces sampled at 1%, every console.error kept
  // (logs.head_sampling_rate 1: this Worker logs only its errors), so failures are all still visible.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  }
}
