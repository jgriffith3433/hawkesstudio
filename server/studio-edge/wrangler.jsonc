// studio.hawkesgen.ai: a Cloudflare Worker that passes every request to Hawkes Studio on Cloud Run, and
// studio.hawkesgen.ai/o/<org>/… to that customer's own Studio (docs/studio-cloudrun.md "The address",
// docs/studio-customers.md section 2). Deploy from this folder: npx wrangler deploy (the first time: npx wrangler login).
// The beta lane (studio-beta.hawkesgen.ai -> the studio-beta service): npx wrangler deploy --env beta
// Customers' Studios need the control plane's edge key once per lane (J: tools/studio-cloudrun/cells-setup.mjs prints how):
//   npx wrangler secret put EDGE_KEY            (and --env beta)
{
  "name": "hawkes-studio-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "studio.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }],
  "vars": {
    // The Cloud Run service's own address (tools/studio-cloudrun/deploy.mjs prints it as "Service URL").
    "STUDIO_ORIGIN": "https://studio-388576319982.us-east4.run.app",
    // Customers' cells: studio-o-<org>-<project number>.<region>.run.app. Empty turns the /o/ routing off.
    "CELLS_PROJECT_NUMBER": "388576319982",
    "CELLS_REGION": "us-east4",
    "CELLS_SERVICE_PREFIX": "studio"
  },
  "observability": { "enabled": true },
  "env": {
    "beta": {
      "routes": [{ "pattern": "studio-beta.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }],
      // Cloud Run's deterministic address for the service studio-beta.
      "vars": {
        "STUDIO_ORIGIN": "https://studio-beta-388576319982.us-central1.run.app",
        "CELLS_PROJECT_NUMBER": "388576319982",
        "CELLS_REGION": "us-central1",
        "CELLS_SERVICE_PREFIX": "studio-beta"
      }
    }
  }
}
